DATABASE_URL=file:./data/underwood-payload.db
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: used only by `pnpm seed:admin` and to prefill the development login form.
# They are never used for production auto-login.
CMS_SEED_ADMIN_EMAIL=admin@example.com
CMS_SEED_ADMIN_PASSWORD=replace-with-a-strong-password

SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_EMAIL_PORT=465
SMTP_API_KEY=your-smtp-password-or-api-key
SMTP_FROM_EMAIL=form@example.com
SMTP_TARGET_EMAIL=recipient@example.com

TELEGRAM_TOKEN=123456:ABCDEF
TELEGRAM_GROUP_CHAT_ID=-1001234567890

GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_DATA_STREAM_ID=123456789
